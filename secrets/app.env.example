# Copy to secrets/app.env for local runs, fill in every value, then chmod 600.
# In GitHub Actions these live as repository SECRETS instead (Settings →
# Secrets and variables → Actions). Secrets cannot be read back out of GitHub,
# so keep a copy in the team password manager, not only in the repo settings.

# ── Data + AI ────────────────────────────────────────────────────────────────
APIFY_TOKEN=apify_api_CHANGEME      # Instagram + Reddit scraping
GEMINI_API_KEY=CHANGEME             # reel/carousel analysis, comment analysis
GROQ_API_KEY=gsk_CHANGEME           # text analysis, comment classification

# ── Email (sender identity) ──────────────────────────────────────────────────
# A 16-character Gmail/Workspace APP PASSWORD, not the account password.
# Generate at https://myaccount.google.com/apppasswords (needs 2FA enabled).
# Whatever address is set here is the visible "From" on the daily report.
GMAIL_USER=CHANGEME@onlywhatsneeded.in
GMAIL_APP_PASS=CHANGEME-16-CHAR-APP-PASS

# ── Optional ─────────────────────────────────────────────────────────────────
# Comma-separated test recipients. Blank = the real list baked into scraper.py.
# EMAIL_TO_OVERRIDE=

# Send only to TEST_EMAIL (defaults to GMAIL_USER) instead of the full list.
# TEST_MODE=true
# TEST_EMAIL=

# Only needed if the FoodPharmer report repo is renamed/moved/made private.
# Set to "off" to drop the FoodPharmer-effect box and collab cross-match.
# FP_HISTORY_URL=
